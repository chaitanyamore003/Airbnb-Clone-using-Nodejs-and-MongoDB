<%- include('./partials/head') %>

<body class="bg-stone-50 text-gray-900">
  <%- include('./partials/nav') %>

  <main class="min-h-[80vh] flex items-center justify-center px-6">

    <div class="max-w-lg w-full bg-white border border-stone-200 rounded-3xl shadow-sm p-10 text-center">

      <div class="text-6xl mb-4">
        ⚠️
      </div>

      <h1 class="text-4xl font-bold text-gray-900 mb-4">
        Something Went Wrong
      </h1>

      <p class="text-gray-500 mb-8">
        We're having trouble processing your request right now.
        Please try again in a few moments.
      </p>

      <a
        href="/"
        class="inline-block bg-[#ff385c] hover:bg-[#e0304f] text-white px-6 py-3 rounded-xl font-semibold transition-colors duration-200"
      >
        Back to Home
      </a>

    </div>

  </main>

</body>
</html>