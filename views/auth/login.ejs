<%- include('../partials/head') %>

<body class="bg-gray-100">
  <%- include('../partials/nav') %>

  <main class="min-h-screen flex items-center justify-center px-4 py-10">
    <div
      class="w-full max-w-md bg-white rounded-3xl shadow-xl border border-gray-100 p-8"
    >
      <!-- Header -->
<div class="text-center mb-8">
  <h1 class="text-3xl font-bold text-gray-900">
    Welcome Back
  </h1>

  <p class="text-gray-500 mt-2">
    Sign in to continue your Airbnb journey
  </p>
</div>

<%- include('../partials/errors') %>

<!-- Login Form -->
<form action="/login" method="POST" class="space-y-5">
        <!-- Email -->
        <div>
          <label
            for="email"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Email
          </label>

          <input
            type="email"
            id="email"
            name="email"
            placeholder="Enter your email"
            value="<%= oldInput?.email || ''%>"
            class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#eb4c60]"
            required
          />
        </div>

        <!-- Password -->
        <div>
          <label
            for="password"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Password
          </label>

          <input
            type="password"
            id="password"
            name="password"
            placeholder="Enter your password"
            class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#eb4c60]"
            required
          />
        </div>

        <!-- Remember Me + Forgot Password -->
        <div class="flex items-center justify-between text-sm">
          <label class="flex items-center gap-2 text-gray-600">
            <input
              type="checkbox"
              name="remember"
              class="accent-[#eb4c60]"
            />
            Remember me
          </label>

          <a
            href="/forgot-password"
            class="text-[#eb4c60] hover:underline font-medium"
          >
            Forgot Password?
          </a>
        </div>

        <!-- Login Button -->
        <button
          type="submit"
          method="POST"
          class="w-full bg-[#eb4c60] hover:bg-[#d93f52] text-white font-semibold py-3 rounded-xl transition duration-200"
        >
          Login
        </button>
      </form>

      <!-- Signup Section -->
        <div class="mt-8 border-t border-gray-200 pt-6 text-center">
          <p class="text-gray-600 mb-4">
           Don't have an account yet?
        </p>

        <a
        href="/signup"
        class="block w-full bg-white border-2 border-[#eb4c60] text-[#eb4c60] hover:bg-[#eb4c60] hover:text-white font-semibold py-3 rounded-xl transition duration-200"
        >
           Create New Account
        </a>
    </div>
    </div>
  </main>
</body>
</html>