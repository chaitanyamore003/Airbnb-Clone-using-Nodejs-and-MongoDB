<%- include('../partials/head') %>

<body class="bg-gray-100">
  <%- include('../partials/nav') %>

  <main class="min-h-screen flex items-center justify-center px-4 py-10">
    <div
      class="w-full max-w-2xl bg-white rounded-3xl shadow-xl border border-gray-100 p-8"
    >
      <!-- Header -->
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-gray-900">
          Create Your Account
        </h1>

        <p class="text-gray-500 mt-2">
          Join Airbnb and start exploring unique stays around the world
        </p>
      </div>

      <%- include('../partials/errors')%>

      <!-- Signup Form -->
      <form action="/signup" method="POST" class="space-y-5">

        <!-- First Name & Last Name -->
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label
              for="firstName"
              class="block text-sm font-semibold text-gray-700 mb-2"
            >
              First Name
            </label>

            <input
              type="text"
              id="firstName"
              name="firstName"
              value="<%= oldInput?.firstName || '' %>"
              placeholder="Enter your first name"
              class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#eb4c60]"
              required
            />
          </div>

          <div>
            <label
              for="lastName"
              class="block text-sm font-semibold text-gray-700 mb-2"
            >
              Last Name
            </label>

            <input
              type="text"
              id="lastName"
              name="lastName"
              value="<%= oldInput?.lastName || '' %>"
              placeholder="Enter your last name"
              class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#eb4c60]"
              required
            />
          </div>
        </div>

        <!-- Email -->
        <div>
          <label
            for="email"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Email Address
          </label>

          <input
            type="email"
            id="email"
            name="email"
            value="<%= oldInput?.email || '' %>"
            placeholder="Enter your email address"
            class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#eb4c60]"
            required
          />
        </div>

        <!-- Account Type -->
        <div>
          <label
            class="block text-sm font-semibold text-gray-700 mb-3"
          >
            Account Type
          </label>

          <div class="flex gap-8">
            <label
              class="flex items-center gap-2 text-gray-700 cursor-pointer"
            >
              <input
                type="radio"
                name="userType"
                value="guest"
                class="accent-[#eb4c60]"
                <%= oldInput?.userType === 'guest' ? 'checked' : '' %>
                required
              />
              Guest
            </label>

            <label
              class="flex items-center gap-2 text-gray-700 cursor-pointer"
            >
              <input
                type="radio"
                name="userType"
                value="host"
                class="accent-[#eb4c60]"
                <%= oldInput?.userType === 'host' ? 'checked' : '' %>
              />
              Host
            </label>
          </div>
        </div>

        <!-- Password -->
        <div>
          <label
            for="password"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Password
          </label>

          <input
            type="password"
            id="password"
            name="password"
            placeholder="Create a password"
            class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#eb4c60]"
            required
          />
        </div>

        <!-- Confirm Password -->
        <div>
          <label
            for="confirmPassword"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Confirm Password
          </label>

          <input
            type="password"
            id="confirmPassword"
            name="confirmPassword"
            placeholder="Confirm your password"
            class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#eb4c60]"
            required
          />
        </div>

        <!-- Terms & Conditions -->
        <div class="flex items-start gap-3">
          <input
            type="checkbox"
            id="terms"
            name="terms"
            class="mt-1 accent-[#eb4c60]"
            <%= oldInput?.terms ? 'checked' : '' %>
            required
          />

          <label for="terms" class="text-sm text-gray-600">
            I agree to the
            <a
              href="/terms"
              class="text-[#eb4c60] font-medium hover:underline"
            >
              Terms & Conditions
            </a>
            and
            <a
              href="/privacy"
              class="text-[#eb4c60] font-medium hover:underline"
            >
              Privacy Policy
            </a>
          </label>
        </div>

        <!-- Signup Button -->
        <button
          type="submit"
          class="w-full bg-[#eb4c60] hover:bg-[#d93f52] text-white font-semibold py-3 rounded-xl transition duration-200"
        >
          Create Account
        </button>
      </form>

      <!-- Login Link -->
      <div class="mt-8 border-t border-gray-200 pt-6 text-center">
        <p class="text-gray-600">
          Already have an account?

          <a
            href="/login"
            class="text-[#eb4c60] font-semibold hover:underline"
          >
            Sign In
          </a>
        </p>
      </div>
    </div>
  </main>
</body>

</html>
