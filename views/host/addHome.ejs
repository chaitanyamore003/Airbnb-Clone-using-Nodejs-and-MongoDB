<%- include('../partials/head') %>

<body class="bg-gray-50">
  <%- include('../partials/nav') %>

  <main class="max-w-6xl mx-auto px-6 py-10">

<!-- Header -->
<div class="mb-8">
  <h1 class="text-4xl font-bold text-gray-900">
    Add New Property
  </h1>

  <p class="text-gray-500 mt-2">
    Create a new listing and start welcoming guests.
  </p>
</div>

<div class="grid lg:grid-cols-2 gap-10">

  <!-- Form Section -->
  <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8">

    <%- include('../partials/errors') %>

    <form action="/host/add-home" method="POST" enctype="multipart/form-data" class="space-y-5">

      <!-- Property Name -->
      <div>
        <label
          for="name"
          class="block text-sm font-semibold text-gray-700 mb-2"
        >
          Property Name
        </label>

        <input
          type="text"
          id="name"
          name="name"
          value="<%= oldInput?.name || '' %>"
          placeholder="Luxury Beach Villa"
          class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#eb4c60]"
          required
        >
      </div>

      <!-- Price -->
      <div>
        <label
          for="price"
          class="block text-sm font-semibold text-gray-700 mb-2"
        >
          Price Per Night (₹)
        </label>

        <input
          type="number"
          id="price"
          name="price"
          value="<%= oldInput?.price || '' %>"
          placeholder="2500"
          class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#eb4c60]"
          required
        >
      </div>

      <!-- Location -->
      <div>
        <label
          for="location"
          class="block text-sm font-semibold text-gray-700 mb-2"
        >
          Location
        </label>

        <input
          type="text"
          id="location"
          name="location"
          value="<%= oldInput?.location || '' %>"
          placeholder="Goa, Mumbai, Pune..."
          class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#eb4c60]"
          required
        >
      </div>

            <!-- Description -->
      <div>
        <label
          for="description"
          class="block text-sm font-semibold text-gray-700 mb-2"
        >
          Description
        </label>
      <textarea
        id="description"
        name="description"
        rows="5"
        placeholder="Describe your property, nearby attractions, amenities, and what makes it special..."
        class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#eb4c60] resize-none"
        required
      ><%= oldInput?.description || '' %></textarea>
      </div>

      <!-- Rating -->
      <div>
        <label
          for="rating"
          class="block text-sm font-semibold text-gray-700 mb-2"
        >
          Rating
        </label>

        <input
          type="number"
          id="rating"
          name="rating"
          value="<%= oldInput?.rating || '' %>"
          min="1"
          max="5"
          step="0.1"
          placeholder="4.8"
          class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#eb4c60]"
        >
      </div>

        <!-- Property Images -->
      <div>
        <label
          for="photo"
          class="block text-sm font-semibold text-gray-700 mb-2"
        >
          Property Images
        </label>

        <input
          type="file"
          id="photo"
          name="photo"
          accept="image/*"
          class="w-full rounded-xl border border-gray-300 px-4 py-3 bg-white focus:outline-none focus:ring-2 focus:ring-[#eb4c60]"
        />

        <p class="mt-2 text-xs text-gray-500">
          Upload one or more images (JPG, PNG, WEBP, etc.)
        </p>
      </div>

      <!-- Actions -->
      <div class="flex gap-4 pt-4">

        <button
          type="submit"
          class="flex-1 bg-[#eb4c60] hover:bg-[#d93f52] text-white font-semibold py-3 rounded-xl transition"
        >
          Add Property
        </button>

        <a
          href="/host/host-homes-list"
          class="flex-1 text-center border border-gray-300 hover:border-gray-400 py-3 rounded-xl font-medium text-gray-700 transition"
        >
          Cancel
        </a>

      </div>

    </form>

  </div>

  <!-- Preview Panel -->
  <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6">

    <h2 class="text-2xl font-semibold mb-5">
      Listing Preview
    </h2>

    <div class="rounded-2xl overflow-hidden mb-5 bg-gray-100">
      <img
        src="/images/place-holder.jpg"
        alt="Property Preview"
        class="w-full h-[350px] object-cover"
      >
    </div>

    <h3 class="text-2xl font-bold text-gray-900">
      Your Property Name
    </h3>

<p class="text-gray-500 mt-2">
  📍 Property Location
</p>

<div class="mt-5">
  <h4 class="font-semibold text-gray-900 mb-2">
    About this property
  </h4>

  <p class="text-gray-600 leading-relaxed">
    Your property description will appear here. Tell guests what makes your place unique, comfortable, and worth booking.
  </p>
</div>

    <div class="flex items-center justify-between mt-5">

      <p class="text-3xl font-bold">
        ₹0
        <span class="text-sm text-gray-500 font-normal">
          / night
        </span>
      </p>

      <span class="text-yellow-500 font-semibold">
        ⭐ 0.0
      </span>

    </div>

    <div class="mt-6 p-4 bg-pink-50 rounded-xl border border-pink-100">
      <p class="text-sm text-gray-600">
        Complete the form to create a professional property listing that guests can discover and book.
      </p>
    </div>

  </div>

</div>

  </main>

</body>
</html>
