<%- include('../partials/head') %>

<body class="bg-gray-50">
  <%- include('../partials/nav') %>

  <main class="max-w-7xl mx-auto px-6 py-10">

<!-- Header -->
<div class="mb-10">
  <h1 class="text-4xl font-bold text-gray-900">
    Your Properties
  </h1>

  <p class="text-gray-500 mt-2">
    Manage, edit and monitor all properties you've listed.
  </p>
</div>

<% if (registeredHomes && registeredHomes.length > 0) { %>

  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">

    <% registeredHomes.forEach(home => { %>

      <div
        class="bg-white rounded-3xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300">

        <!-- Property Image -->
        <div class="relative overflow-hidden">

          <img
            src="<%= home.photo %>"
            alt="<%= home.name %>"
            class="w-full h-60 object-cover hover:scale-105 transition duration-500"
          >

          <div
            class="absolute top-4 right-4 bg-[#eb4c60] text-white text-xs px-3 py-1 rounded-full">
            Active
          </div>

        </div>

        <!-- Property Details -->
        <div class="p-6">

          <div class="flex justify-between items-start mb-3">

            <h2 class="text-xl font-semibold text-gray-900">
              <%= home.name %>
            </h2>

            <span class="text-yellow-500 font-medium">
              ⭐ <%= home.rating %>
            </span>

          </div>

          <p class="text-gray-500 mb-2">
            📍 <%= home.location %>
          </p>

          <p class="text-2xl font-bold text-gray-900 mb-6">
            ₹<%= home.price %>
            <span class="text-sm text-gray-500 font-normal">
              / night
            </span>
          </p>

          <!-- Action Buttons -->
          <div class="flex gap-3">

            <a
              href="/host/edit-home/<%= home._id %>"
              class="flex-1 text-center py-3 rounded-xl bg-[#eb4c60] hover:bg-[#d93f52] text-white font-medium transition"
            >
              Edit Property
            </a>

            <form
              action="/host/delete-home"
              method="POST"
            >
              <input
                type="hidden"
                name="homeId"
                value="<%= home._id %>"
              >

              <button
                type="submit"
                class="px-4 py-3 rounded-xl border border-red-300 text-red-500 hover:bg-red-500 hover:text-white transition"
              >
                Delete
              </button>
            </form>

          </div>

        </div>

      </div>

    <% }) %>

  </div>

<% } else { %>

  <!-- Empty State -->

  <div
    class="bg-white rounded-3xl border border-gray-100 shadow-sm p-16 text-center">

    <div class="text-8xl mb-6">
      🏠
    </div>

    <h2 class="text-3xl font-bold text-gray-800 mb-3">
      No Properties Yet
    </h2>

    <p class="text-gray-500 mb-8 max-w-lg mx-auto">
      Start hosting by listing your first property and reach thousands of guests.
    </p>

    <a
      href="/host/add-home"
      class="inline-flex items-center bg-[#eb4c60] hover:bg-[#d93f52] text-white px-8 py-4 rounded-xl font-semibold transition"
    >
      Add Your First Property
    </a>

  </div>

<% } %>

  </main>

</body>
</html>
