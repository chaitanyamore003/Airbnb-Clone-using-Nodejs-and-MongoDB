<%- include('../partials/head') %>

<body class="bg-gray-50 min-h-screen">
  <%- include('../partials/nav') %>

  <main class="max-w-7xl mx-auto px-6 py-10">

    <!-- Page Header -->
    <div class="mb-10">
      <h1 class="text-4xl font-bold text-gray-900">
        Your Favourite Homes ❤️
      </h1>

      <p class="text-gray-500 mt-2">
        Keep track of the places you love and revisit them anytime.
      </p>
    </div>

    <% if (favouriteHomes && favouriteHomes.length > 0) { %>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">

        <% favouriteHomes.forEach(home => { %>

          <div
            class="bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100">

            <!-- Property Image -->
            <div class="overflow-hidden">
              <img
                src="<%= home.photo %>"
                alt="<%= home.name %>"
                class="w-full h-64 object-cover hover:scale-105 transition duration-500">
            </div>

            <!-- Card Content -->
            <div class="p-6">

              <div class="flex justify-between items-start mb-3">
                <h2 class="text-xl font-semibold text-gray-900">
                  <%= home.name %>
                </h2>

                <span class="text-yellow-500 font-medium">
                  ⭐ <%= home.rating %>
                </span>
              </div>

              <p class="text-gray-500 mb-4">
                📍 <%= home.location %>
              </p>

              <div class="flex items-center justify-between mb-6">
                <p class="text-xl font-bold text-gray-900">
                  ₹<%= home.price %>
                  <span class="text-sm text-gray-500 font-normal">
                    / night
                  </span>
                </p>
              </div>

              <!-- Actions -->
              <div class="flex gap-3">

                <a href="/details/<%= home._id %>"
                  class="flex-1 text-center py-3 rounded-xl bg-[#eb4c60] text-white font-medium hover:bg-[#d93f52] transition">
                  View Details
                </a>

                <form action="/remove-favourite" method="POST">

                <input
                  type="hidden"
                  name="homeId"
                  value="<%= home._id %>"
                >

                <button
                  type="submit"
                  class="px-4 py-3 rounded-xl border border-red-300 text-red-500 hover:bg-red-500 hover:text-white transition">

                  Remove

                </button>

              </form>

              </div>

            </div>

          </div>

        <% }) %>

      </div>

    <% } else { %>

      <!-- Empty State -->

      <div
        class="bg-white rounded-3xl shadow-sm border border-gray-100 p-16 text-center">

        <div class="text-8xl mb-6">
          ❤️
        </div>

        <h2 class="text-3xl font-bold text-gray-800 mb-3">
          No Favourite Homes Yet
        </h2>

        <p class="text-gray-500 max-w-lg mx-auto mb-8">
          Start exploring amazing properties and save your favourite homes
          to quickly access them later.
        </p>

        <a href="/"
          class="inline-flex items-center bg-[#eb4c60] hover:bg-[#d93f52] text-white px-8 py-4 rounded-xl font-semibold transition">
          Explore Homes
        </a>

      </div>

    <% } %>

  </main>

</body>
</html>