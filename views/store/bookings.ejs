<%- include('../partials/head') %>

<body class="bg-stone-50 text-gray-900 antialiased">
  <%- include('../partials/nav') %>

  <main class="max-w-7xl mx-auto px-6 py-10">

    <!-- Header -->
    <div class="flex items-baseline justify-between mb-8">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-gray-900">
          My Bookings
        </h1>

        <p class="text-sm text-gray-400 mt-1">
          Homes you've booked for your next stay
        </p>
      </div>

      <% if (bookedHomes && bookedHomes.length > 0) { %>
        <span class="text-xs font-medium text-gray-500 bg-stone-200 px-4 py-1.5 rounded-full">
          <%= bookedHomes.length %> booking<%= bookedHomes.length !== 1 ? 's' : '' %>
        </span>
      <% } %>
    </div>

    <!-- Bookings Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">

      <% if (bookedHomes && bookedHomes.length > 0) { %>

        <% bookedHomes.forEach(home => { %>

          <a
            href="/details/<%= home._id %>"
            class="block group bg-white rounded-2xl overflow-hidden border border-stone-200 hover:-translate-y-1 hover:shadow-xl transition-all duration-300"
          >

            <!-- Image -->
            <div class="relative h-48 overflow-hidden">
              <img
                src="<%= home.photo %>"
                alt="<%= home.name %>"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />

              <div class="absolute top-3 left-3 flex items-center gap-1 bg-white/90 backdrop-blur-sm text-gray-800 text-xs font-semibold px-2.5 py-1 rounded-full shadow-sm">
                <span class="text-amber-400">★</span>
                <%= home.rating %>
              </div>
            </div>

            <!-- Body -->
            <div class="p-4">

              <p class="font-semibold text-gray-900 text-sm truncate mb-1">
                <%= home.name %>
              </p>

              <p class="flex items-center gap-1 text-xs text-gray-400 mb-4">
                <svg
                  class="w-3.5 h-3.5 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                  />
                </svg>

                <%= home.location %>
              </p>

              <div class="flex items-center justify-between pt-3 border-t border-stone-100">

            <p class="text-base font-bold text-gray-900">
              ₹<%= home.price %>
              <span class="text-xs font-normal text-gray-400">
                / night
              </span>
            </p>

              <div class="flex items-center gap-2">

                <span class="text-xs font-semibold text-green-600 bg-green-50 px-3 py-1.5 rounded-lg">
                  Booked
                </span>

                <form
                  action="/bookings/remove"
                  method="POST"
                  onclick="event.stopPropagation();"
                >
                  <input
                    type="hidden"
                    name="homeId"
                    value="<%= home._id %>"
                  />

                  <button
                    type="submit"
                    class="text-xs font-semibold text-white bg-red-500 hover:bg-red-600 px-3 py-1.5 rounded-lg transition-colors duration-150"
                  >
                    Cancel
                  </button>
                </form>

              </div>

            </div>

            </div>

          </a>

        <% }) %>

      <% } else { %>

        <div class="col-span-full flex flex-col items-center justify-center py-20">

          <div class="bg-white rounded-3xl border border-stone-200 p-10 text-center max-w-md">

            <h2 class="text-2xl font-bold text-gray-800 mb-3">
              No Bookings Yet
            </h2>

            <p class="text-gray-500 mb-6">
              Start exploring amazing properties and book your next stay.
            </p>

            <a
              href="/"
              class="inline-block bg-[#ff385c] hover:bg-[#e0304f] text-white px-6 py-3 rounded-xl font-semibold transition-colors duration-200"
            >
              Explore Homes
            </a>

          </div>

        </div>

      <% } %>

    </div>

  </main>

</body>
</html>