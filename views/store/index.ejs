<%- include('../partials/head') %>

<body class="bg-stone-50 text-gray-900 antialiased">
  <%- include('../partials/nav') %>

  <main class="max-w-7xl mx-auto px-6 py-10">

    <!-- Page Header -->
    <div class="flex items-baseline justify-between mb-8">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-gray-900">
          Places to stay
        </h1>

        <p class="text-sm text-gray-400 mt-1">
          Handpicked homes, just for you
        </p>
      </div>

      <% if (registeredHomes && registeredHomes.length > 0) { %>
        <span class="text-xs font-medium text-gray-500 bg-stone-200 px-4 py-1.5 rounded-full">
          <%= registeredHomes.length %> home<%= registeredHomes.length !== 1 ? 's' : '' %>
        </span>
      <% } %>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">

      <% if (registeredHomes && registeredHomes.length > 0) { %>

        <% registeredHomes.forEach(home => { %>

          <!-- Home Card -->
          <div
            onclick="location.href='/details/<%= home._id %>'"
            class="cursor-pointer group bg-white rounded-2xl overflow-hidden border border-stone-200 hover:-translate-y-1 hover:shadow-xl transition-all duration-300"
          >

            <!-- Image -->
            <div class="relative h-48 overflow-hidden">
              <img
                src="<%= home.photo %>"
                alt="<%= home.name %>"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />

              <!-- Rating Badge -->
              <div class="absolute top-3 left-3 flex items-center gap-1 bg-white/90 backdrop-blur-sm text-gray-800 text-xs font-semibold px-2.5 py-1 rounded-full shadow-sm">
                <span class="text-amber-400">★</span>
                <%= home.rating %>
              </div>
            </div>

            <!-- Body -->
            <div class="p-4">

              <p class="font-semibold text-gray-900 text-sm truncate mb-1">
                <%= home.name %>
              </p>

              <p class="flex items-center gap-1 text-xs text-gray-400 mb-4">
                <svg
                  class="w-3.5 h-3.5 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                  />
                </svg>

                <%= home.location %>
              </p>

              <!-- Footer -->
              <div class="flex items-center justify-between pt-3 border-t border-stone-100">

                <p class="text-base font-bold text-gray-900">
                  ₹<%= home.price %>
                  <span class="text-xs font-normal text-gray-400">
                    / night
                  </span>
                </p>

                <div class="flex gap-2">

                  <a
                    href="/details/<%= home._id %>"
                    onclick="event.stopPropagation()"
                    class="text-xs font-medium text-gray-600 border border-gray-200 hover:border-gray-400 hover:text-gray-900 px-3 py-1.5 rounded-lg transition-all duration-150"
                  >
                    Details
                  </a>

                  <form
                    action="/bookings"
                    method="POST"
                    onclick="event.stopPropagation()"
                  >
                    <input
                      type="hidden"
                      name="homeId"
                      value="<%= home._id %>"
                    />

                    <button
                      type="submit"
                      class="text-xs font-semibold text-white bg-[#ff385c] hover:bg-[#e0304f] px-3 py-1.5 rounded-lg transition-colors duration-150"
                    >
                      Book Now
                    </button>
                  </form>

                </div>

              </div>

            </div>

          </div>

        <% }) %>

      <% } else { %>

        <div class="col-span-full flex flex-col items-center justify-center py-20 text-gray-400">
          <p class="text-base font-medium">
            No homes registered yet.
          </p>
        </div>

      <% } %>

    </div>

  </main>

</body>
</html>