<%- include('../partials/head') %>

</head>

<body class="bg-gray-50">
  <%- include('../partials/nav') %>

  <main class="max-w-7xl mx-auto px-4 py-8">

<!-- Property Header -->
<section class="mb-8">

  <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-3">
    <%= home.name %>
  </h1>

  <div class="flex flex-wrap items-center gap-4 text-sm text-gray-600">

    <span class="flex items-center gap-1 font-medium">
      ⭐ <%= home.rating %>
    </span>

    <span>•</span>

    <span>
      📍 <%= home.location %>
    </span>

  </div>

</section>

<!-- Hero Image -->
<section class="mb-10">
  <div class="overflow-hidden rounded-3xl shadow-lg">

    <img
      src="<%= home.photo %>"
      alt="<%= home.name %>"
      class="w-full h-[600px] object-cover hover:scale-105 transition duration-700"
    >

  </div>
</section>

<!-- Main Layout -->
<section class="grid lg:grid-cols-3 gap-10">

  <!-- Left Side -->
  <div class="lg:col-span-2 space-y-8">

    <!-- Property Intro -->
    <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-8">

      <h2 class="text-2xl font-semibold mb-3">
        Entire Property in <%= home.location %>
      </h2>

      <p class="text-gray-600 leading-relaxed">
        Experience comfort and convenience in a carefully curated stay designed for relaxation and memorable moments.
      </p>

    </div>

    <!-- Property Stats -->
    <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-8">

      <h2 class="text-xl font-semibold mb-6">
        Quick Overview
      </h2>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">

        <div>
          <p class="text-3xl mb-2">🏠</p>
          <p class="font-medium">Entire Home</p>
        </div>

        <div>
          <p class="text-3xl mb-2">⭐</p>
          <p class="font-medium"><%= home.rating %> Rating</p>
        </div>

        <div>
          <p class="text-3xl mb-2">📍</p>
          <p class="font-medium">Prime Location</p>
        </div>

        <div>
          <p class="text-3xl mb-2">💎</p>
          <p class="font-medium">Premium Stay</p>
        </div>

      </div>

    </div>

    <!-- Amenities -->
    <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-8">

      <h2 class="text-xl font-semibold mb-6">
        What this place offers
      </h2>

      <div class="grid md:grid-cols-2 gap-4">

        <div class="flex items-center gap-3">
          📶 <span>High-Speed Wi-Fi</span>
        </div>

        <div class="flex items-center gap-3">
          🚗 <span>Free Parking</span>
        </div>

        <div class="flex items-center gap-3">
          🛏️ <span>Comfortable Bedrooms</span>
        </div>

        <div class="flex items-center gap-3">
          ❄️ <span>Air Conditioning</span>
        </div>

        <div class="flex items-center gap-3">
          🍽️ <span>Kitchen Access</span>
        </div>

        <div class="flex items-center gap-3">
          🔒 <span>Secure Property</span>
        </div>

      </div>

    </div>

    <!-- Description -->
    <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-8">

      <h2 class="text-2xl font-semibold mb-4">
        About this place
      </h2>

      <p class="text-gray-600 leading-8 whitespace-pre-line">
        <%= home.description %>
      </p>

    </div>

  </div>

  <!-- Booking Card -->
  <div>

    <div class="sticky top-24 bg-white rounded-3xl shadow-xl border border-gray-200 p-6">

      <div class="mb-6">

        <span class="text-4xl font-bold text-gray-900">
          ₹<%= home.price %>
        </span>

        <span class="text-gray-500">
          / night
        </span>

      </div>

        <form action="/bookings" method="POST">
        <input
          type="hidden"
          name="homeId"
          value="<%= home._id %>"
        />

        <button
          type="submit"
          class="w-full bg-[#eb4c60] hover:bg-[#d93f52] text-white font-semibold py-3 rounded-xl transition"
        >
          Book Now
        </button>
      </form>

      <button
        class="w-full mt-3 border border-gray-300 hover:border-gray-400 text-gray-700 font-medium py-3 rounded-xl transition">
        Contact Host
      </button>

      <!-- Pricing -->
      <div class="mt-6 pt-6 border-t">

        <div class="flex justify-between mb-2">
          <span>Nightly Rate</span>
          <span>₹<%= home.price %></span>
        </div>

        <div class="flex justify-between mb-2">
          <span>Service Fee</span>
          <span>₹499</span>
        </div>

        <div class="flex justify-between mb-2">
          <span>Taxes</span>
          <span>₹199</span>
        </div>

        <div class="flex justify-between font-semibold text-lg mt-4 pt-4 border-t">

          <span>Total</span>

          <span>
            ₹<%= Number(home.price) + 499 + 199 %>
          </span>

        </div>

      </div>

      <!-- Favourite Button -->
      <div class="mt-6">
        <%- include('../partials/favourites', { home: home }) %>
      </div>

    </div>

  </div>

</section>

  </main>

</body>
</html>
